# SACPulse Server Configuration
PORT=5001
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Persistence Mode ('supabase' for cloud PostgreSQL, 'memory' for 100% offline local mode)
PERSISTENCE_DRIVER=supabase

# Supabase Configuration
SUPABASE_PROJECT_REF=<your-supabase-project-ref>
SUPABASE_URL=https://<your-supabase-project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# Optional: Direct PostgreSQL Connection URL (e.g. Supabase Transaction Pooler port 6543 or session port 5432)
# DATABASE_URL=postgresql://postgres.[project_ref]:[password]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres

# Authentication & Security
GOOGLE_CLIENT_ID=<your-google-oauth-client-id>.apps.googleusercontent.com
JWT_SECRET=<replace-with-at-least-32-character-random-secret>
INITIAL_ADMIN_EMAIL=admin@iiita.ac.in

